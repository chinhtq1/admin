   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "ems-poc-db"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT device_id, quality, count(*) AS n, max(ts) AS last\nFROM telemetry WHERE ts > now() - interval '15 minutes' GROUP BY 1,2 ORDER BY 1,2"
