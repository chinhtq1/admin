     "rawSql": "SELECT ts AS time, point_code AS metric, value/1000 AS value FROM telemetry\nWHERE $__timeFilter(ts) AND quality='GOOD' AND device_id='ess-01'\n  AND point_code IN ('ess.p_setpoint','ess.p','ess.p_charge_max','ess.p_discharge_max') ORDER BY 1"
    }
