  {
   "id": 2,
   "type": "timeseries",
   "title": "Công suất site (kW) — dấu: lưới + nhập, BESS + xả",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "ems-poc-db"
   },
   "gridPos": {
    "x": 0,
    "y": 2,
    "w": 24,
    "h": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "kwatt",
     "custom": {
      "lineWidth": 2,
      "spanNulls": 120000
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "ems-poc-db"
     },
     "format": "time_series",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT ts AS time,\n  CASE WHEN device_id='meter-poc' THEN 'P_grid (+ nhập)' WHEN device_id='meter-load' THEN 'P_load'\n       WHEN point_code='pv_inverter.p' THEN 'P_pv (7 inverter)' WHEN point_code='ess.p' THEN 'P_ess (+ xả)'\n       ELSE 'P_ev' END AS metric,\n  sum(value)/1000 AS value\nFROM telemetry\nWHERE $__timeFilter(ts) AND quality='GOOD'\n  AND point_code IN ('meter.p','pv_inverter.p','ess.p','evse.p')\nGROUP BY 1,2 ORDER BY 1"
    }
   ]
  },
  {
