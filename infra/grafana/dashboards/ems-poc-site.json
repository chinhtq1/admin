  {
   "id": 5,
   "type": "table",
   "title": "Vòng đời lệnh (cmd-ack)",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "ems-poc-db"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 14,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "ems-poc-db"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT a.ts AS \"time\", left(a.command_id,13) AS command, c.type, a.state,\n  coalesce(a.payload->>'reason','') AS reason, a.payload->'effective_setpoint'->>'p_w' AS p_w\nFROM command_ack a LEFT JOIN command c USING (command_id) ORDER BY a.id DESC LIMIT 40"
    }
   ]
  },
  {
   "id": 6,
   "type": "table",
   "title": "Quality 15 phút gần nhất",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "ems-poc-db"
   },
   "gridPos": {
    "x": 14,
    "y": 20,
