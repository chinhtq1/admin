# Copy to .env and set real values (.env is git-ignored). Never commit real passwords.
COMPOSE_PROJECT_NAME=emspoc
DB_PASSWORD=change-me-db
MQTT_PASS_EDGE_VSITE01=change-me-edge-vsite01
MQTT_PASS_EDGE_EV01=change-me-edge-ev01
MQTT_PASS_INGEST=change-me-ingest
MQTT_PASS_DISPATCHER=change-me-dispatcher
MQTT_PASS_HEALTH=change-me-health
GRAFANA_ADMIN_PASSWORD=change-me-grafana
# Virtual site clock: 1 = real time; >1 accelerates PV/load profile and energy integration
SIM_SPEED=1
SIM_START_LOCAL=10:30
# Optional: CA bundle for a TLS-intercepting proxy, used only at image build time (BuildKit secret)
BUILD_CA_FILE=./empty-ca.pem
